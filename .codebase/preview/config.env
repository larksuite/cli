# Identity of the merge-request preview package, read by .codebase/preview/build.sh.
#
# PREVIEW_PACKAGE must differ from RELEASE_PACKAGE in ../release/config.env. A
# preview is never published, and a shared name would give `npm install -g` a
# path to a build that came out of one merge request.
PREVIEW_PACKAGE=@byted/larksuite-cli-preview
# Platforms a preview carries, comma separated. Two macOS builds cover the
# reviewers; add linux/amd64 when a case needs it. Every extra platform costs
# about 14 MB in the tarball and a cross-compile in the job.
PREVIEW_PLATFORMS=darwin/arm64,darwin/amd64
