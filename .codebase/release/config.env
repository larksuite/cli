# Distribution identity of the internal release, read by .codebase/release/*.sh.
# RELEASE_GO_VERSION pins the toolchain like the public release workflow does;
# build.sh exports it as GOTOOLCHAIN and refuses binaries built with anything
# else.
RELEASE_PACKAGE=@byted/larksuite-cli
RELEASE_REGISTRY=https://bnpm.byted.org
RELEASE_GO_VERSION=1.26.5
