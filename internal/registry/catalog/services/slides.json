              "example": "zTqAwsEb4clrjOLd3drAcNZabcef"
            },
            "page_token": {
              "type": "string",
              "location": "query",
              "required": false,
              "description": "分页游标",
              "example": "MTY4NzI1MjQwMDAwMA=="
            },
            "page_size": {
              "type": "integer",
              "location": "query",
              "required": false,
              "description": "分页数量",
              "default": 20,
              "example": 20,
              "max": "20",
              "min": "1"
            }
          },
          "parameterOrder": [
            "xml_presentation_id"
          ],
          "responseBody": {
            "entries": {
              "type": "array",
              "description": "演示文稿历史版本列表",
              "required": false,
              "properties": {
                "revision_id": {
                  "type": "integer",
                  "description": "revision_id",
                  "required": false,
                  "example": 11,
                  "max": "2147483647",
                  "min": "0"
                },
                "edit_time": {
                  "type": "string",
                  "description": "历史版本编辑时间",
                  "required": false,
                  "example": "2026-06-16T11:24:12Z"
                },
                "type": {
                  "type": "integer",
                  "description": "历史版本类型",
                  "required": false,
                  "example": 1,
                  "max": "2147483647",
                  "min": "0"
                },
                "name": {
                  "type": "string",
                  "description": "历史版本名称",
                  "required": false,
                  "example": "版本名称"
                },
                "description": {
                  "type": "string",
                  "description": "历史版本描述",
                  "required": false,
                  "example": "版本描述"
                },
                "editor_ids": {
                  "type": "array",
                  "description": "编辑者 ID 列表",
                  "required": false,
                  "example": "[\"1777013770000\",\"1777013770001\"]"
                },
                "history_version_id": {
                  "type": "string",
                  "description": "历史记录 id，用于回滚到指定历史版本",
                  "required": false,
                  "example": "51341231231"
                }
              }
            },
            "has_more": {
              "type": "boolean",
              "description": "是否还有更多数据",
              "required": false,
              "example": true
            },
            "page_token": {
              "type": "string",
              "description": "下一页分页游标",
              "required": false,
              "example": "MTY4NzI1MjQwMDAwMQ=="
            }
          },
          "scopes": [
            "slides:presentation:read"
          ],
          "accessTokens": [
            "tenant",
            "user"
          ],
          "risk": "read",
          "docUrl": "https://open.feishu.cn/api-explorer?from=op_doc_tab&apiName=list&project=slides_ai&resource=xml_presentation.history&version=v1"
        },
        "revert": {
          "id": "xml_presentation.history.revert",
          "path": "xml_presentations/{xml_presentation_id}/history/revert",
          "httpMethod": "POST",
          "description": "按 history_version_id 发起 XML 演示文稿历史版本回滚任务",
          "parameters": {
            "xml_presentation_id": {
              "type": "string",
              "location": "path",
              "required": true,
              "description": "演示文稿唯一标识",
              "example": "zTqAwsEb4clrjOLd3drAcNZabcef"
            }
          },
          "parameterOrder": [
            "xml_presentation_id"
          ],
          "requestBody": {
            "history_version_id": {
              "type": "string",
              "description": "要回滚到的历史版本 id，由历史版本列表接口返回",
              "required": true,
              "example": "3072"
            }
          },
          "responseBody": {
            "task_id": {
              "type": "string",
              "description": "回滚任务 ID",
              "required": false,
              "example": "task_xxx"
            },
            "status": {
              "type": "string",
              "description": "回滚任务状态",
              "required": false,
              "example": "running",
              "options": [
                {
                  "value": "done",
                  "description": "已完成"
                },
                {
                  "value": "partial_failed",
                  "description": "部分失败"
                },
                {
                  "value": "running",
                  "description": "执行中"
                },
                {
                  "value": "failed",
                  "description": "失败"
                }
              ],
              "enum": [
                "done",
                "partial_failed",
                "running",
                "failed"
              ]
            },
            "poll_after_ms": {
              "type": "integer",
              "description": "建议下次轮询间隔，单位毫秒",
              "required": false,
              "example": 10000,
              "max": "2147483647",
              "min": "0"
            },
            "history_version_id": {
              "type": "string",
              "description": "回滚到的历史版本 id",
              "required": false,
              "example": "1777013770000"
            }
          },
          "scopes": [
            "slides:presentation:update",
            "slides:presentation:write_only"
          ],
          "accessTokens": [
            "user",
            "tenant"
          ],
          "danger": true,
          "risk": "write",
          "docUrl": "https://open.feishu.cn/api-explorer?from=op_doc_tab&apiName=revert&project=slides_ai&resource=xml_presentation.history&version=v1"
        },
        "revert_status": {
          "id": "xml_presentation.history.revert_status",
          "path": "xml_presentations/{xml_presentation_id}/history/revert_status",
          "httpMethod": "GET",
          "description": "查询 XML 演示文稿历史回滚任务状态",
          "parameters": {
            "xml_presentation_id": {
              "type": "string",
              "location": "path",
              "required": true,
              "description": "演示文稿唯一标识",
              "example": "zTqAwsEb4clrjOLd3drAcNZabcef"
            },
            "task_id": {
              "type": "string",
              "location": "query",
              "required": true,
              "description": "回滚任务 ID",
              "example": "task_xxx"
            }
          },
          "parameterOrder": [
            "xml_presentation_id"
          ],
          "responseBody": {
            "status": {
              "type": "string",
              "description": "回滚任务状态",
              "required": false,
              "example": "running",
              "options": [
                {
                  "value": "done",
                  "description": "已完成"
                },
                {
                  "value": "partial_failed",
                  "description": "部分失败"
                },
                {
                  "value": "running",
                  "description": "执行中"
                },
                {
                  "value": "failed",
                  "description": "失败"
                }
              ],
              "enum": [
                "done",
                "partial_failed",
                "running",
                "failed"
              ]
            },
            "failed_block_tokens": {
              "type": "array",
              "description": "回滚失败的 block token 列表",
              "required": false
            },
            "history_version_id": {
              "type": "string",
              "description": "回滚到的历史版本 id",
              "required": false,
              "example": "1777013770000"
            }
          },
          "scopes": [
            "slides:presentation:read"
          ],
          "accessTokens": [
            "user",
            "tenant"
          ],
          "risk": "read",
          "docUrl": "https://open.feishu.cn/api-explorer?from=op_doc_tab&apiName=revert_status&project=slides_ai&resource=xml_presentation.history&version=v1"
        }
      }
    },
