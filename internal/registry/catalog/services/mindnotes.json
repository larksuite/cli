              "description": "Mindnote唯一标识",
              "example": "D05hbLa3dm08GbnerjwbvNmUcgf"
            },
            "user_id_type": {
              "type": "string",
              "location": "query",
              "required": false,
              "description": "此次调用中使用的用户ID的类型",
              "options": [
                {
                  "value": "user_id",
                  "description": "以user_id来识别用户"
                },
                {
                  "value": "union_id",
                  "description": "以union_id来识别用户"
                },
                {
                  "value": "open_id",
                  "description": "以open_id来识别用户"
                }
              ],
              "enum": [
                "user_id",
                "union_id",
